# Copy this file to .env and fill in your own API keys.
# .env is git-ignored so your real keys never get committed.

# Required for the "quintessential foods" feature (app.py --food).
# Get a key at https://console.anthropic.com/ and put your real key in
# your local .env file only — never commit it or paste it into chat.
ANTHROPIC_API_KEY=your_api_key_here

# Example: API key for a future points-of-interest data source
# POI_API_KEY=your_api_key_here

# Example: API key for a future books data source
# BOOKS_API_KEY=your_api_key_here
